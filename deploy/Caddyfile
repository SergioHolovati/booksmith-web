# Caddy em produção: HTTPS automático (Let's Encrypt) para {$SITE_ADDRESS}, o app Angular como arquivos estáticos,
# a API por proxy em /api, o login do Google em /oauth2 e /login/oauth2, e as imagens do MinIO em /media.
# Tudo no mesmo domínio: sem CORS, e o cookie HttpOnly da sessão fica em /api/v1/auth.
# (O Let's Encrypt não exige e-mail de contato; o Caddy renova o certificado sozinho.)

# www -> sem www (um endereço só, também para o Google e para o cookie da sessão)
www.{$SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Cabeçalhos de segurança para tudo (a API ainda manda a CSP dela; o app tem a CSP na <meta>)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# Corpo no máximo 20 MB (a API já limita uploads a 15 MB; isto barra antes de chegar nela)
	request_body {
		max_size 20MB
	}

	@api path /api/* /oauth2/* /login/oauth2/* /actuator/health
	handle @api {
		reverse_proxy api:8080
	}

	# /media/: primeiro os arquivos do próprio app que o build do Angular põe ali (as fontes dos ícones); o resto
	# vai para o bucket público do MinIO (as imagens dos autores; só leitura, o upload passa pela API)
	handle /media/* {
		header Cache-Control "public, max-age=31536000, immutable"
		route {
			@appfile file {
				root /srv
			}
			file_server @appfile {
				root /srv
			}
			uri strip_prefix /media
			rewrite * /{$MEDIA_BUCKET}{uri}
			reverse_proxy minio:9000 {
				header_up Host minio:9000
			}
		}
	}

	# O app: arquivos com hash no nome ficam em cache por um ano; o index e o service worker nunca
	handle {
		root * /srv
		header Content-Security-Policy "frame-ancestors 'none'"
		@hashed {
			path *.js *.css *.woff2 *.woff *.png *.svg *.ico *.webp *.jpg
			not path /ngsw-worker.js /ngsw.json /manifest.webmanifest
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh path /index.html /ngsw-worker.js /ngsw.json /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
