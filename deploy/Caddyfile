# Caddy em produção: HTTPS automático (Let's Encrypt) para {$SITE_ADDRESS}, o app Angular como arquivos estáticos,
# a API por proxy em /api, o login do Google em /oauth2 e /login/oauth2, e as imagens do MinIO em /media.
# Tudo no mesmo domínio: sem CORS, e o cookie HttpOnly da sessão fica em /api/v1/auth.
# (O Let's Encrypt não exige e-mail de contato; o Caddy renova o certificado sozinho.)

# Atrás da Cloudflare (quando o domínio passar por ela, para a detecção de CSAM): o IP do visitante vem no
# CF-Connecting-IP, aceito SÓ de conexões que chegam pelos endereços da Cloudflare (lista oficial em
# https://www.cloudflare.com/ips/, 23/11/2026). Sem Cloudflare, nada muda: o IP é o da conexão.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# www -> sem www (um endereço só, também para o Google e para o cookie da sessão)
www.{$SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Cabeçalhos de segurança para tudo (a API ainda manda a CSP dela; o app tem a CSP na <meta>)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# Corpo no máximo 105 MB: o livro pronto em PDF vai até 100 MB (a API confere cada envio; texto e capa: 15 MB)
	request_body {
		max_size 105MB
	}

	# As rotas da equipe não existem pelo endereço do app: só pelo backoffice (a API confere de novo, ADMIN_HOST)
	handle /api/v1/admin/* {
		respond 404
	}

	@api path /api/* /oauth2/* /login/oauth2/* /actuator/health
	handle @api {
		# A API recebe só o IP do visitante (o real, mesmo atrás da Cloudflare): limite por IP e bloqueio de login
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# /fonts/: endereço das fontes numa versão antiga do app (14/11); celulares que guardaram essa versão continuam
	# com os ícones. Os arquivos são os mesmos de /media/.
	handle_path /fonts/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# /media/: primeiro os arquivos do próprio app que o build do Angular põe ali (as fontes dos ícones); o resto
	# vai para o bucket público do MinIO (as imagens dos autores; só leitura, o upload passa pela API)
	handle /media/* {
		header Cache-Control "public, max-age=31536000, immutable"
		route {
			@appfile file {
				root /srv
			}
			file_server @appfile {
				root /srv
			}
			uri strip_prefix /media
			rewrite * /{$MEDIA_BUCKET}{uri}
			reverse_proxy minio:9000 {
				header_up Host minio:9000
			}
		}
	}

	# O app: arquivos com hash no nome ficam em cache por um ano; o index e o service worker nunca
	handle {
		root * /srv
		header Content-Security-Policy "frame-ancestors 'none'"
		@hashed {
			path *.js *.css *.woff2 *.woff *.png *.svg *.ico *.webp *.jpg
			not path /ngsw-worker.js /ngsw.json /manifest.webmanifest
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh path /index.html /ngsw-worker.js /ngsw.json /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Backoffice da equipe (outro domínio, sessão própria: o cookie da sessão é deste endereço, não do app).
# Só passam para a API o login, o perfil e as rotas da equipe; o resto da API não existe aqui.
# Na Cloudflare, este endereço fica atrás do Cloudflare Access (login por e-mail antes de a página abrir).
{$ADMIN_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	request_body {
		max_size 1MB
	}

	@api path /api/v1/auth/* /api/v1/profile /api/v1/admin/*
	handle @api {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /api/* {
		respond 404
	}

	# /media/: as fontes dos ícones do próprio backoffice e as miniaturas da moderação (bucket do MinIO)
	handle /media/* {
		header Cache-Control "public, max-age=31536000, immutable"
		route {
			@adminfile file {
				root /srv-admin
			}
			file_server @adminfile {
				root /srv-admin
			}
			uri strip_prefix /media
			rewrite * /{$MEDIA_BUCKET}{uri}
			reverse_proxy minio:9000 {
				header_up Host minio:9000
			}
		}
	}

	handle {
		root * /srv-admin
		header Content-Security-Policy "frame-ancestors 'none'"
		@hashed {
			path *.js *.css *.woff2 *.woff *.png *.svg *.ico
			not path /index.html
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
